# SQLite local (desarrollo rápido, sin Docker).
DATABASE_URL=sqlite:///./local.db

# Nivel de log del paquete `app` (p. ej. LoggingNotifier, E2). Por
# defecto INFO; se ve junto a los logs de uvicorn en stdout/Docker.
LOG_LEVEL=INFO

# PostgreSQL (alineado con docker-compose y producción, A7). Descomentar
# y ajustar credenciales para usarlo en vez de SQLite.
# DATABASE_URL=postgresql+psycopg://crehana:crehana@localhost:5432/crehana_tasklists

# --- Solo para docker-compose ---
# Credenciales del servicio Postgres (docker-compose.yml). Los valores
# de abajo son por defecto SOLO para desarrollo local; no usarlos en
# producción. docker-compose construye DATABASE_URL a partir de estas
# tres variables, así que no hace falta repetirla aquí para Docker.
POSTGRES_USER=crehana
POSTGRES_PASSWORD=crehana
POSTGRES_DB=crehana_tasklists
